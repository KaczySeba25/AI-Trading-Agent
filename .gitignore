# --- Secrets: never commit these -------------------------------------------
.env
.env.local
*.pem
*.key

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# --- Virtual environments ----------------------------------------------------
# Both layouts: bin/ on POSIX, Scripts/ on Windows.
.venv/
venv/
env/
Scripts/
share/
pyvenv.cfg
Lib/
Include/

# --- Runtime artefacts -------------------------------------------------------
# Agent state and models are machine-local: they are rebuilt by running the
# agent and would otherwise put multi-megabyte binaries into every diff.
state/
models/
logs/
*.log
runs/

# --- Data ---------------------------------------------------------------------
# Market data is regenerated by scripts/generate_sample_data.py or downloaded.
data/*.csv
data/*.json
data/live_paper_*.json
data/online_learning_*.json
!data/.gitkeep

# --- Editors / OS --------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
