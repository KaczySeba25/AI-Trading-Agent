# Copy to .env.local and fill in. .env.local is gitignored; never commit keys.

# --- Market -------------------------------------------------------------------
TRADING_SYMBOL=BTCUSDT
INITIAL_CAPITAL=500

# --- Credentials ------------------------------------------------------------------
# Leave blank to run fully offline (paper trading and backtests need no keys).
# Start with TESTNET keys from https://testnet.binancefuture.com
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Trading switches -------------------------------------------------------------
# Both default to false. ENABLE_LIVE_TRADING risks real money: turn it on only
# after a long paper run you are happy with.
ENABLE_TESTNET_TRADING=false
ENABLE_LIVE_TRADING=false

# --- Risk ---------------------------------------------------------------------------
MAX_POSITION_FRACTION=0.02
DEFAULT_LEVERAGE=1
MAX_LEVERAGE=5
DAILY_LOSS_LIMIT_FRACTION=0.05
MAX_CONSECUTIVE_LOSSES=12
MAX_TRADES_PER_DAY=2000
MIN_SECONDS_BETWEEN_TRADES=0

# --- Costs ----------------------------------------------------------------------------
# Set these to YOUR actual fee tier. Too optimistic here and every backtest lies.
MAKER_FEE_FRACTION=0.0002
TAKER_FEE_FRACTION=0.0004
SLIPPAGE_FRACTION=0.0001
PREFER_MAKER=true

# --- Exits ------------------------------------------------------------------------------
USE_ATR_EXITS=true
ATR_STOP_MULTIPLE=1.5
ATR_TARGET_MULTIPLE=2.5
TRAILING_STOP_ENABLED=true
MAX_HOLDING_BARS=60

# --- Reward shaping -----------------------------------------------------------------------
# INACTIVITY_PENALTY drives trading frequency up; CHURN_PENALTY holds it back.
# Raise the first for more trades, raise the second if the agent overtrades.
INACTIVITY_PENALTY=0.002
CHURN_PENALTY=0.01
HOLDING_PENALTY=0.0005

# --- Learning -------------------------------------------------------------------------------
OBSERVATION_WINDOW=32
TRAIN_STEPS=2048
LEARNING_RATE=0.0003
ENTROPY_COEFFICIENT=0.02
SEED=42
