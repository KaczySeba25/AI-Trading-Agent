# Copy to .env.local and fill in. .env.local is git-ignored.
# Nothing here is required for backtesting, training or paper trading.

# --- Market ---
TRADING_SYMBOL=BTCUSDT
INITIAL_CAPITAL=500
PUBLIC_MARKET_DATA_BASE_URL=https://api.binance.com
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/stream

# --- Credentials (only needed for testnet/live order placement) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET_BASE_URL=https://testnet.binancefuture.com

# --- Safety switches: keep both false until you are certain ---
ENABLE_TESTNET_TRADING=false
ENABLE_LIVE_TRADING=false

# --- Risk ---
MAX_OPEN_POSITIONS=8
MAX_POSITION_FRACTION=0.02
DEFAULT_LEVERAGE=3
MAX_LEVERAGE=5
STOP_LOSS_FRACTION=0.003
TAKE_PROFIT_FRACTION=0.006
DAILY_LOSS_LIMIT_FRACTION=0.05

# --- Execution cost model ---
TAKER_FEE_FRACTION=0.0004
SLIPPAGE_FRACTION=0.0002

# --- Learning ---
OBSERVATION_WINDOW=32
TRAIN_STEPS=2048
LEARNING_RATE=0.0003
SEED=42

# --- Paths (relative to repo root) ---
STATE_DIR=state
MODEL_DIR=models
DATA_DIR=data
LOG_DIR=logs
